{
  "name": "دفتري — دفتر ودراسة",
  "short_name": "دفتري",
  "description": "دفتر حقيقي بتقلّبه: عربي وإنجليزي، أسئلة مراجعة وامتحانات، تقويم دراسة، وكل شي بيشتغل بدون إنترنت.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "lang": "ar",
  "dir": "rtl",
  "background_color": "#0a1836",
  "theme_color": "#0b1a3a",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./index.html", "accept": { "application/x-daftar": [".daftar"] } }
  ],
  "shortcuts": [
    { "name": "كتاب جديد", "url": "./index.html?do=new", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "تقويم الدراسة", "url": "./index.html?do=cal", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
